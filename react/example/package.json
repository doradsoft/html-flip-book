{
	"name": "html-flip-book-react-example",
	"version": "0.0.0-alpha.88",

	"private": true,
	"description": "Flipbook component for HTML",
	"homepage": "https://doradsoft.github.io/html-flip-book/",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"predev": "node -e \"try{require('child_process').execSync('bunx kill-port 5173',{stdio:'ignore'})}catch{}\"",
		"dev": "vite",
		"predeploy": "bun run build",
		"deploy": "gh-pages -d dist -r https://github.com/doradsoft/html-flip-book.git",
		"build": "vite build --mode development",
		"generate:en-pdf": "node scripts/generate-en-pdf.mts"
	},
	"author": "DoradSoft",
	"license": "MIT",
	"dependencies": {
		"html-flip-book-react": "*",
		"jspdf": "^4.2.1",
		"pdf-merger-js": "^5.1.2",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-markdown": "^10.1.0"
	},
	"devDependencies": {
		"@actions/core": "^3.0.0",
		"@mdpdf/mdpdf": "^0.1.4",
		"@types/react": "^19.2.13",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react-refresh": "^1.3.6",
		"@vitejs/plugin-react-swc": "^4.2.3",
		"gh-pages": "6.3.0",
		"react-refresh": "^0.19.0",
		"rimraf": "^6.1.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vite-plugin-checker": "^0.14.5",
		"vite-tsconfig-paths": "^6.1.0",
		"vitest": "^5.0.5"
	}
}
