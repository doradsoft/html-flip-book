{
	"name": "html-flip-book",
	"version": "0.0.0-alpha.76",
	"description": "Flipbook component for HTML",
	"homepage": "https://doradsoft.github.io/html-flip-book/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/doradsoft/html-flip-book.git"
	},
	"bugs": {
		"url": "https://github.com/doradsoft/html-flip-book/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "npm@12.2.1",
	"workspaces": [
		"base",
		"react",
		"react/example"
	],
	"scripts": {
		"prepare": "husky",
		"update": "npx npm-check-updates --peer --deep -u && npm install",
		"build": "npm run build:react",
		"build:base": "cross-env BUILD_TARGET=base vite build && tsc -p base/tsconfig.json --emitDeclarationOnly",
		"build:react": "npm run build:base && cross-env BUILD_TARGET=react vite build && tsc -p react/tsconfig.json --emitDeclarationOnly",
		"build:example": "npm run build --workspace=html-flip-book-react-example",
		"dev": "npm run dev --workspace=html-flip-book-react-example",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"perf": "node scripts/perf-run.mts",
		"perf:compare": "node scripts/perf-run.mts --base",
		"coverage:unit": "vitest run --coverage",
		"coverage:e2e": "playwright test",
		"coverage:merge": "node scripts/merge-coverage.mts",
		"coverage:badge": "make-coverage-badge --report-path .coverage/unit/coverage-summary.json --output-path ./badges/coverage.svg",
		"format:write": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"ci-test": "vitest run --coverage && playwright test && npm run coverage:merge",
		"all": "npm run check && npm run test:coverage && npm run build",
		"docs": "typedoc",
		"release": "node scripts/release.mts",
		"release:patch": "node scripts/release.mts patch",
		"release:minor": "node scripts/release.mts minor",
		"release:major": "node scripts/release.mts major"
	},
	"author": "DoradSoft",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@playwright/test": "^1.64.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^25.2.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/semver": "^7.8.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"@vitest/coverage-istanbul": "^4.0.18",
		"cross-env": "^10.1.0",
		"happy-dom": "^21.0.4",
		"husky": "^9.1.7",
		"make-coverage-badge": "^1.2.0",
		"monocart-reporter": "^2.15.1",
		"pdf-lib": "^1.17.1",
		"pdf-merger-js": "^5.1.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sass": "^1.106.1",
		"semver": "^7.8.5",
		"typedoc": "^0.28.20",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^4.0.18"
	},
	"allowScripts": {
		"@swc/core@1.16.20": true,
		"esbuild@0.28.2": true,
		"@parcel/watcher@2.6.0": true
	}
}
