{
	"name": "html-flip-book",
	"version": "0.0.0-alpha.88",

	"description": "Flipbook component for HTML",
	"homepage": "https://doradsoft.github.io/html-flip-book/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/doradsoft/html-flip-book.git"
	},
	"bugs": {
		"url": "https://github.com/doradsoft/html-flip-book/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"base",
		"react",
		"react/example"
	],
	"scripts": {
		"prepare": "husky",
		"update": "bunx npm-check-updates --peer --deep -u && bun install",
		"build": "bun run build:react",
		"build:base": "cross-env BUILD_TARGET=base vite build && tsc -p base/tsconfig.json --emitDeclarationOnly",
		"build:react": "bun run build:base && cross-env BUILD_TARGET=react vite build && tsc -p react/tsconfig.json --emitDeclarationOnly",
		"build:example": "bun --filter html-flip-book-react-example build",
		"dev": "bun --filter html-flip-book-react-example dev",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"perf": "node scripts/perf/compare.mts",
		"perf:selfcheck": "node scripts/perf/compare.mts --selfcheck --delay-candidate-ms 25 --samples 4 --scenario turn",
		"coverage:unit": "vitest run --coverage",
		"coverage:e2e": "playwright test",
		"coverage:merge": "node scripts/merge-coverage.mts",
		"coverage:badge": "make-coverage-badge --report-path .coverage/unit/coverage-summary.json --output-path ./badges/coverage.svg",
		"format:write": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"ci-test": "vitest run --coverage && playwright test && bun run coverage:merge",
		"all": "bun run check && bun run test:coverage && bun run build",
		"docs": "typedoc",
		"release": "node scripts/release.mts",
		"release:patch": "node scripts/release.mts patch",
		"release:minor": "node scripts/release.mts minor",
		"release:major": "node scripts/release.mts major"
	},
	"author": "DoradSoft",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@playwright/test": "^1.64.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^25.2.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/semver": "^7.8.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"@vitest/coverage-istanbul": "5.0.5",
		"cross-env": "^10.1.0",
		"happy-dom": "^21.0.4",
		"husky": "^9.1.7",
		"make-coverage-badge": "^1.2.0",
		"monocart-reporter": "^2.15.1",
		"pdf-lib": "^1.17.1",
		"pdf-merger-js": "^5.1.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sass": "^1.106.1",
		"semver": "^7.8.5",
		"typedoc": "^0.28.20",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"trustedDependencies": [
		"@swc/core",
		"esbuild",
		"@parcel/watcher"
	]
}
